# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model routing
MODEL_L1=deepseek-chat          # Flash - 批量生成
MODEL_L2=deepseek-reasoner      # Pro - 复杂编排
MODEL_L3=claude-sonnet-4-6      # 兜底 - 自愈/评审 (可选)

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-v2-m3
