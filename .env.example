# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model routing (Flash-Only)
DEEPSEEK_MODEL=deepseek-flash   # 唯一模型，reasoning 档位区分 low/high

# 本地 Ollama 离线兜底 (可选)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# auto: 远端优先，不可达时回退本地嵌入式 Qdrant（无需 Docker）
# 可选 remote | local | memory | off
QDRANT_MODE=auto
QDRANT_LOCAL_PATH=
# 检索 score 阈值过滤（不接 reranker）
RAG_SCORE_THRESHOLD=0.0
# RAG 总开关；0 = 降级为不检索
RAG_ENABLED=1

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Embedding（Phase G：fake 开发用 dim=8；bge 生产用）
RAG_EMBEDDER=fake
RAG_FAKE_DIM=8
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
